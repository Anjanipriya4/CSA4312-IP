<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Professional Resume</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #e9edf2;
            color: #333;
            padding: 30px;
        }

        .resume {
            max-width: 850px;
            margin: auto;
            background: white;
            display: grid;
            grid-template-columns: 280px 1fr;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        }

        .left {
            background: #17324d;
            color: white;
            padding: 30px 22px;
        }

        .right {
            padding: 35px 30px;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 10px;
        }

        .role {
            color: #f3c969;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        h2 {
            font-size: 17px;
            margin: 24px 0 12px;
            padding-bottom: 7px;
            border-bottom: 2px solid #e3b34c;
        }

        .left h2 {
            color: #f3c969;
        }

        .right h2 {
            color: #17324d;
        }

        p, li {
            font-size: 13px;
            line-height: 1.7;
        }

        ul {
            padding-left: 18px;
        }

        .contact p {
            margin-bottom: 8px;
            overflow-wrap: anywhere;
        }

        .item {
            margin-bottom: 18px;
        }

        .item h3 {
            font-size: 15px;
            margin-bottom: 5px;
            color: #263d54;
        }

        .date {
            font-size: 12px;
            color: #777;
            margin-bottom: 6px;
        }

        .tagline {
            color: #555;
            font-size: 13px;
            line-height: 1.8;
        }

        .buttons {
            max-width: 850px;
            margin: 20px auto;
            text-align: center;
        }

        button {
            padding: 12px 22px;
            background: #17324d;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        button:hover {
            background: #28577f;
        }

        @media (max-width: 650px) {
            body {
                padding: 10px;
            }

            .resume {
                grid-template-columns: 1fr;
            }

            .left, .right {
                padding: 25px;
            }
        }

        @media print {
            body {
                padding: 0;
                background: white;
            }

            .resume {
                max-width: 100%;
                box-shadow: none;
            }

            .buttons {
                display: none;
            }

            .left, .right {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>

